    {
        "id": "c74c51efc782dfa8",
        "type": "function",
        "z": "0b25a34679899bc4",
        "name": "function 6",
        "func": "// current CSV row\nlet row = msg.payload;\n\n// device name\nlet devName = row[\"Device Name ZigBee Source\"] || \"unknown\";\n\n// create MQTT topic\nmsg.topic = \"ZigBee/\" + devName;\n\n// create MQTT payload\nmsg.payload = {\n\n    timestamp: Math.floor(Date.now() / 1000),\n\n    id: flow.get(\"current_id\"),\n\n    \"wpan.src\":\n        \"0x\" + String(row[\"Source Address\"] || \"\").replace(/^0x/, \"\"),\n\n    \"wpan.dst\":\n        \"0x\" + String(row[\"Destination Address\"] || \"\").replace(/^0x/, \"\"),\n\n    \"zbee.src\":\n        \"0x\" + String(row[\"Source Address ZigBee\"] || \"\").replace(/^0x/, \"\"),\n\n    \"zbee.dst\":\n        \"0x\" + String(row[\"Destination Address ZigBee\"] || \"\").replace(/^0x/, \"\"),\n\n    topic: msg.topic,\n\n    payload: row[\"Command String\"]\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
