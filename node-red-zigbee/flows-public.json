    {
        "id": "e31270c7d0e6cd46",
        "type": "function",
        "z": "0b25a34679899bc4",
        "name": "Export links",
        "func": "let links = flow.get(\"links\") || {};\n\nlet rows = [];\nlet count = 1;\n\nfor (let source in links) {\n    for (let destination in links[source]) {\n        rows.push({\n            \"No.\": count,\n            \"Source\": source,\n            \"Destination\": destination,\n            \"Cost\": links[source][destination]\n        });\n        count++;\n    }\n}\n\nmsg.payload = rows;\n\nreturn msg;",
        "outputs": 1,
