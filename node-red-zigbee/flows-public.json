    {
        "id": "8708141048442164",
        "type": "function",
        "z": "0b25a34679899bc4",
        "name": "Link State function",
        "func": "let row = msg.payload;\n\nlet N = flow.get(\"current_N\");\n\n// check Packet Number = N\nif (Number(row[\"Packet Number\"]) !== Number(N)) {\n    return null;\n}\n\nlet cmd = String(row[\"Command String\"] || \"\");\n\n// check Link Status\nif (!cmd.includes(\"Link Status\")) {\n    return null;\n}\n\nlet source = row[\"Source Address ZigBee\"];\n\nlet links = flow.get(\"links\") || {};\n\nif (!links[source]) {\n    links[source] = {};\n}\n\n// extract Address + Outgoing Cost together\nlet regex = /'Address':\\s*'(0x[0-9a-fA-F]+)'.*?'Outgoing Cost':\\s*'(\\d+)'/g;\n\nlet match;\n\nwhile ((match = regex.exec(cmd)) !== null) {\n\n    let destination = match[1];\n    let cost = match[2];\n\n    links[source][destination] = cost;\n}\n\nflow.set(\"links\", links);\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1890,
        "y": 300,
