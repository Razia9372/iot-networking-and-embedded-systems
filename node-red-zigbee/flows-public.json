    {
        "id": "0350efd6c3c5e361",
        "type": "function",
        "z": "0b25a34679899bc4",
        "name": "function 2",
        "func": "// received MQTT message\nlet data = msg.payload;\n\n// get ID\nlet id = Number(data.ID);\n\n// stop after 200 messages\nlet count = flow.get(\"sub_count\") || 0;\n\nif (count >= 200) {\n    return null;\n}\n\ncount++;\n\nflow.set(\"sub_count\", count);\n\n// compute N\nlet N = id % 5218;\n\n// save values\nflow.set(\"current_N\", N);\nflow.set(\"current_id\", id);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
