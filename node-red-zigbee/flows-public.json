    {
        "id": "752130df1de188d5",
        "type": "function",
        "z": "0b25a34679899bc4",
        "name": "function 7",
        "func": "let cmd = msg.payload.payload;\n\n// if command does not contain useful attributes, stop\nif (\n    !cmd.includes(\"Active Power\") &&\n    !cmd.includes(\"RMS Current\") &&\n    !cmd.includes(\"RMS Voltage\")\n) {\n    return null;\n}\n\n// get timestamp from previous payload\nlet timestamp = msg.payload.timestamp;\n\n// row counter\nlet count = flow.get(\"filtered_count\") || 0;\n\nlet rows = [];\n\n// Active Power\nif (cmd.includes(\"Active Power\")) {\n    count++;\n\n    rows.push({\n        \"No.\": count,\n        \"Timestamp\": timestamp,\n        \"Sequence Number\": \"99\",\n        \"Attribute\": \"Active Power\",\n        \"Status\": \"Success\",\n        \"Data Type\": \"16-Bit Signed Integer\",\n        \"Data Value\": 0\n    });\n}\n\n// RMS Current\nif (cmd.includes(\"RMS Current\")) {\n    count++;\n\n    rows.push({\n        \"No.\": count,\n        \"Timestamp\": timestamp,\n        \"Sequence Number\": \"99\",\n        \"Attribute\": \"RMS Current\",\n        \"Status\": \"Success\",\n        \"Data Type\": \"16-Bit Unsigned Integer\",\n        \"Data Value\": 0\n    });\n}\n\n// RMS Voltage\nif (cmd.includes(\"RMS Voltage\")) {\n    count++;\n\n    rows.push({\n        \"No.\": count,\n        \"Timestamp\": timestamp,\n        \"Sequence Number\": \"99\",\n        \"Attribute\": \"RMS Voltage\",\n        \"Status\": \"Success\",\n        \"Data Type\": \"16-Bit Unsigned Integer\",\n        \"Data Value\": 223\n    });\n}\n\n// save counter\nflow.set(\"filtered_count\", count);\n\n// send rows to CSV node\nmsg.payload = rows;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
